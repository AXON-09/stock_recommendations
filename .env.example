# ── QuantView AI configuration ────────────────────────────────────────────
# Copy to .env and adjust. All values are optional; defaults are safe for dev.

# CORS: comma-separated list of allowed origins. Leave unset for "*" (dev only).
ALLOWED_ORIGINS=https://your-app.onrender.com

# Model cache: max number of trained tickers kept in memory (LRU eviction).
MAX_CACHED_MODELS=32

# Max simultaneous XGBoost + LSTM training jobs (CPU protection).
MAX_CONCURRENT_FITS=2

# Rate limiting (per client IP)
RATE_LIMIT_REQUESTS=60      # general /api/ calls...
RATE_LIMIT_WINDOW_S=60      # ...per this many seconds
HEAVY_LIMIT_REQUESTS=10     # /api/recommend + /api/backtest calls...
HEAVY_LIMIT_WINDOW_S=60     # ...per this many seconds

# Optional market-data provider key
TWELVEDATA_API_KEY=
